# =========================
# OCR (English + Kannada)
# =========================
# OCR server for scanned PDFs and images (no local OCR). IndicOCR
# (http://101.53.137.13:8004/indicocr/ocr_markdown) also works.
OCR_API_URL=http://101.53.140.252/ocr
OCR_API_TIMEOUT=900
OCR_MAX_PAGES=10

# =========================
# LLM - only used for fields the rules could not find
# =========================
# none     = rules only
# generate = hosted "/generate" server (GENERATE_URL)
# openai   = any OpenAI-compatible API (OPENAI_BASE_URL / OPENAI_MODEL)
# ollama   = local Ollama (OLLAMA_MODEL)
LLM_PROVIDER=generate
GENERATE_URL=http://101.53.137.13:8004/vllm/generate_greedy
# keep 1.0 - higher values stop the model copying names from the text
GENERATE_REPETITION_PENALTY=1.0
# true only for Qwen3 /generate (not needed for /generate_greedy - thinking is already off)
GENERATE_NO_THINK=false

OPENAI_BASE_URL=http://101.53.137.13:8004/vllm_openai/v1
OPENAI_MODEL=qwen2.5-3b-instruct
OPENAI_API_KEY=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

REQUEST_TIMEOUT=300
MAX_RETRIES=3
